{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "a11y.ts",
    "*-acceptance.ts",
    "validation-faults.ts",
    "../src/validation/saxon-js.d.ts",
    "validation/**/*.ts"
  ],
  "exclude": ["../dist", "src/content/docs/api"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": false,
    "allowImportingTsExtensions": true
  }
}
