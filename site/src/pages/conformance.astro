---
/** The conformance checklist: the body is generated from the code and the fixtures by scripts/conformance.ts. */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { generatedText, headingsOf } from '../lib/generated';

const body = generatedText('conformance.html');
if (!body) throw new Error('site/.generated/conformance.html is missing: run site/prepare.ts first');
---

<StarlightPage
  frontmatter={{
    title: 'Conformance checklist',
    description:
      'Where every supported e-invoice format stands: detection rule, fixtures, parser, real samples, mapping source and validation layers, generated from the code on every build.',
    template: 'splash',
  }}
  headings={headingsOf(body)}
>
  {/* Generated by scripts/conformance.ts, which escapes every value it writes. */}
  <Fragment set:html={body} />
</StarlightPage>
