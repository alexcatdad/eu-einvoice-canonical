---
/**
 * The real-world results, rendered from the latest corpus report (scripts/fetch-corpus-report.sh downloads it in CI).
 * Without a report the page is a placeholder, so the navigation never dead-ends.
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { generatedJson, generatedText, headingsOf } from '../lib/generated';
import { href } from '../lib/nav';

const body = generatedText('corpus.html');
const meta = generatedJson<{ description: string }>('corpus.json');
---

<StarlightPage
  frontmatter={{
    title: 'Real-world results',
    description:
      meta?.description ?? 'The converter run over public e-invoice sample collections: how many files convert, how fast, and where it warns.',
    template: 'splash',
  }}
  headings={body ? headingsOf(body) : []}
>
  {
    body ? (
      // Generated by scripts/corpus-lib.ts, which escapes every value taken from the report.
      <Fragment set:html={body} />
    ) : (
      <p class="lede">
        No corpus report is part of this build. The page is rendered from the latest corpus run when the site is published from{' '}
        <code>main</code>. Until then, see the <a href={href('conformance/')}>conformance checklist</a> for what each format is tested
        with.
      </p>
    )
  }
</StarlightPage>
