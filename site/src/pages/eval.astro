---
/** Scores the rules and the optional in-browser language models on the labelled set (site/eval.ts runs it). */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { href } from '../lib/nav';
---

<StarlightPage
  frontmatter={{
    title: 'Line labelling evaluation',
    description:
      'Scores the plain rules and two in-browser language models (WebLLM Qwen3, Chrome Gemini Nano) on a labelled set of invoice lines: role accuracy, relation precision and recall, time, download size and memory.',
    template: 'splash',
    tableOfContents: false,
  }}
>
  <div class="not-content eval">
    <p>
      <a href={href('docs/line-roles-and-relations/')}>How line relations work</a> and why a model is optional. <a href={href('')}
        >Back to the converter</a
      >.
    </p>
    <p>
      Compares the rules alone with the same rules plus a language model, on the labelled set in <code>src/relations/labelled.ts</code> (the descriptor
      and Svefaktura fixtures and synthetic discount, freight, labour, nested-heading and ambiguous-percentage cases). Everything runs in this tab; the
      models are downloaded from their hosts when you press Run, and are cached by the browser afterwards.
    </p>
    <fieldset>
      <legend>Engines</legend>
      <label><input type="checkbox" value="rules" checked disabled /> Rules only (always run, the baseline)</label>
      <div id="engines"></div>
    </fieldset>
    <p class="eval-actions">
      <button type="button" class="btn" id="run">Run</button>
      <button type="button" class="btn secondary" id="copy" disabled>Copy results as JSON</button>
    </p>
    <p class="status" id="status" role="status"></p>
    <div class="table-scroll" id="summary-box" tabindex="0" role="region" aria-label="Results" hidden>
      <table id="summary" class="conformance">
        <thead>
          <tr>
            <th scope="col">Engine</th><th scope="col" class="num">Role accuracy</th><th scope="col" class="num">Relation precision</th><th
              scope="col"
              class="num">Relation recall</th
            ><th scope="col" class="num">Wrong "proven"</th><th scope="col" class="num">Load</th><th scope="col" class="num">Run</th><th
              scope="col"
              class="num">Download</th
            ><th scope="col" class="num">JS heap</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
    <details id="detail" hidden><summary>Per case</summary><pre id="detail-body" tabindex="0"></pre></details>
  </div>
</StarlightPage>

<script>
  import '../../eval.ts';
</script>

<style>
  .eval > * + * {
    margin-top: var(--space-4);
  }
  .eval fieldset {
    margin-top: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--rule);
    border-radius: var(--r);
    background: var(--paper);
  }
  .eval :global(label) {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--control-h);
  }
  .eval-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .status {
    min-height: 1.5em;
    color: var(--muted);
  }
  .eval pre {
    max-height: 20rem;
    overflow: auto;
    padding: var(--space-3);
    border: 1px solid var(--rule);
    background: var(--paper);
  }
</style>
