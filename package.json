{
  "name": "eu-einvoice-canonical",
  "version": "2.0.0",
  "description": "Canonical TypeScript model, detection and parsers for inbound EU e-invoices (Peppol BIS 3, XRechnung, Factur-X, Svefaktura and more)",
  "bin": {
    "einvoice": "lib/cli.js",
    "einvoice-trust-lists": "lib/trust-lists-cli.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome check --write .",
    "lint:ci": "biome ci .",
    "test": "bun test",
    "coverage": "bun test --coverage --coverage-reporter=lcov --coverage-reporter=text",
    "coverage:check": "bun scripts/coverage.ts",
    "conformance": "bun scripts/conformance.ts",
    "sweep:fixtures": "bun scripts/sweep.ts test/fixtures --expect test/fixtures/expected.json",
    "build:schemas": "bun scripts/build-schemas.ts",
    "check:schemas": "bun scripts/build-schemas.ts --check",
    "build:site": "cd site && bun run build",
    "serve:site": "bun run site/serve.ts",
    "verify:bundles": "bun scripts/verify-validation-bundles.ts",
    "check:validation-coverage": "bun scripts/check-validation-coverage.ts",
    "build:bundles": "bun scripts/build-validation-bundles.ts",
    "bench": "bun bench/run.ts",
    "bench:check": "bun bench/run.ts --quick --check",
    "build:cli": "bun scripts/build-cli.ts",
    "build:react-css": "bun scripts/build-react-css.ts",
    "check:react-css": "bun scripts/build-react-css.ts --check",
    "check:lib": "bun run lint:ci && bun run check:schemas && bun run check:react-css && bun run typecheck && bun run check:distribution && bun run verify:bundles && bun run check:validation-coverage && bun run coverage && bun run coverage:check && bun run sweep:fixtures && bun run test:package && bun run test:cli-package",
    "check:site": "bun run build:site && bun run --cwd site typecheck && bun run bench:check",
    "check:a11y": "bun run --cwd site a11y",
    "build:package": "bun scripts/build-package.ts",
    "prepack": "bun run build:package",
    "test:package": "bun scripts/test-package.ts",
    "test:cli-package": "bun scripts/test-cli-package.ts",
    "restore:local-validation": "bun scripts/build-validation-bundles.ts --restore-held",
    "check:distribution": "bun scripts/check-validation-distribution.ts",
    "build:trust-lists": "bun build --compile src/trust-lists-cli.ts --outfile dist/einvoice-trust-lists"
  },
  "author": "",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexcatdad/eu-einvoice-canonical.git"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "asn1js": "^3.0.10",
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1",
    "pkijs": "^3.4.1",
    "saxes": "^6.0.0",
    "saxon-js": "2.7.0",
    "xmllint-wasm": "5.3.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "@modelcontextprotocol/sdk": "1.32.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@seriousme/openapi-schema-validator": "^2.11.0",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fast-check": "^4.10.2",
    "marked": "18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^7.0.2",
    "xslt3": "2.7.0",
    "@modelcontextprotocol/sdk": "1.32.1"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./server": {
      "types": "./lib/server.d.ts",
      "import": "./lib/server.js"
    },
    "./react": {
      "types": "./lib/react/index.d.ts",
      "import": "./lib/react/index.js"
    },
    "./react/invoice.css": "./lib/react/invoice.css",
    "./render": {
      "types": "./lib/render/index.d.ts",
      "import": "./lib/render/index.js"
    },
    "./writers": {
      "types": "./lib/writers/index.d.ts",
      "import": "./lib/writers/index.js"
    },
    "./mcp": {
      "types": "./lib/mcp/server.d.ts",
      "import": "./lib/mcp/server.js"
    },
    "./trust-lists": {
      "types": "./lib/signature/trust-lists.d.ts",
      "import": "./lib/signature/trust-lists.js"
    }
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
