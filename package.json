{
  "name": "eu-einvoice-canonical",
  "version": "1.2.0",
  "description": "Canonical TypeScript model, detection and parsers for inbound EU e-invoices (Peppol BIS 3, XRechnung, Factur-X, Svefaktura and more)",
  "bin": {
    "einvoice": "src/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome check --write .",
    "lint:ci": "biome ci .",
    "test": "bun test",
    "coverage": "bun test --coverage --coverage-reporter=lcov --coverage-reporter=text",
    "coverage:check": "bun scripts/coverage.ts",
    "conformance": "bun scripts/conformance.ts",
    "sweep:fixtures": "bun scripts/sweep.ts test/fixtures --expect test/fixtures/expected.json",
    "build:schemas": "bun scripts/build-schemas.ts",
    "check:schemas": "bun scripts/build-schemas.ts --check",
    "build:site": "bun run site/build.ts",
    "serve:site": "bun run site/serve.ts",
    "verify:bundles": "bun scripts/verify-validation-bundles.ts",
    "build:bundles": "bun scripts/build-validation-bundles.ts",
    "build:cli": "bun build --compile src/cli.ts --outfile dist/einvoice"
  },
  "author": "",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexcatdad/eu-einvoice-canonical.git"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "asn1js": "^3.0.10",
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1",
    "pkijs": "^3.4.1",
    "saxes": "^6.0.0",
    "saxon-js": "2.7.0",
    "xmllint-wasm": "5.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fast-check": "^4.10.2",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^7.0.2",
    "xslt3": "2.7.0"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  }
}
