    "validation/bundles/france-rfe-ubl-1.4.0.04",
    "validation/bundles/hr-cius-ext-ubl-20260313",
    "validation/bundles/nlcius-cii-1.0.3.13",
    "validation/bundles/nlcius-gaccount-1.0.2.13-ubl",
    "validation/bundles/nlcius-ubl-2.0.3.13",
    "validation/bundles/oioubl3-creditnote-3.2.4",
    "validation/bundles/oioubl3-en16931-creditnote-3.2.4",
    "validation/bundles/oioubl3-en16931-invoice-3.2.4",
