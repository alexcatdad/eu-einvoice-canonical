{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "bun"]
  },
  "include": ["src", "test", "scripts", "site/*.ts", "examples/line-annotations/*.ts"],
  "exclude": ["site/src", "site/node_modules", "site/a11y.ts"]
}
